{
  "name": "REPrep — Deadline Reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Los_Angeles",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000001",
      "name": "Hourly 06:07–22:07 PT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "7 6-22 * * *" }
          ]
        }
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000002",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 100],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "cfg-appurl", "name": "appUrl", "value": "https://REPLACE-ME.vercel.app", "type": "string" },
            { "id": "cfg-lookahead", "name": "lookaheadHours", "value": 48, "type": "number" },
            { "id": "cfg-dryrun", "name": "dryRun", "value": false, "type": "boolean" },
            { "id": "cfg-notify", "name": "notifyEmail", "value": "automatewithjon@gmail.com", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000004",
      "name": "Call reminders job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.appUrl }}/api/jobs/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runAt: $now.toISO(), lookaheadHours: $('Config').item.json.lookaheadHours, dryRun: $('Config').item.json.dryRun }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "name": "REPrep Jobs Token" }
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000005",
      "name": "Job OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "ok-status",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            },
            {
              "id": "ok-body",
              "leftValue": "={{ $json.body.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000006",
      "name": "Any sends failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, -100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "failed-gt0",
              "leftValue": "={{ $json.body.failed }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000007",
      "name": "Alert: some reminders failed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1200, -200],
      "parameters": {
        "sendTo": "={{ $('Config').item.json.notifyEmail }}",
        "subject": "=REPrep reminders: {{ $json.body.failed }} of {{ $json.body.due }} failed to send",
        "emailType": "text",
        "message": "=Reminder job ran at {{ $now.toFormat('yyyy-LL-dd HH:mm') }} PT.\n\nDue: {{ $json.body.due }}\nSent: {{ $json.body.sent }}\nSkipped (already sent): {{ $json.body.skipped }}\nFailed: {{ $json.body.failed }}\n\nErrors:\n{{ ($json.body.errors || []).map(e => '- ' + e.dealDateId + ': ' + e.reason).join('\\n') }}\n\nFailed reminders are retried on the next hourly run.",
        "options": { "appendAttribution": false }
      },
      "credentials": {
        "gmailOAuth2": { "name": "Gmail account" }
      }
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000008",
      "name": "All sent",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 0],
      "parameters": {}
    },
    {
      "id": "b7e1c3a0-0001-4c1a-9a01-000000000009",
      "name": "Alert: job failed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 250],
      "parameters": {
        "sendTo": "={{ $('Config').item.json.notifyEmail }}",
        "subject": "=REPrep reminders job FAILED ({{ $json.statusCode ?? 'no response' }})",
        "emailType": "text",
        "message": "=The hourly reminder job did not complete at {{ $now.toFormat('yyyy-LL-dd HH:mm') }} PT. No reminders were confirmed sent this run.\n\nEndpoint: {{ $('Config').item.json.appUrl }}/api/jobs/reminders\nHTTP status: {{ $json.statusCode ?? 'none (network error or timeout)' }}\nDetail: {{ JSON.stringify($json.body ?? $json.error ?? $json).slice(0, 1500) }}\n\nCheck: Vercel runtime logs for /api/jobs/reminders, the REPrep Jobs Token credential, and that Config.appUrl is the production URL.",
        "options": { "appendAttribution": false }
      },
      "credentials": {
        "gmailOAuth2": { "name": "Gmail account" }
      }
    }
  ],
  "connections": {
    "Hourly 06:07–22:07 PT": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Manual test": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Call reminders job", "type": "main", "index": 0 }]]
    },
    "Call reminders job": {
      "main": [
        [{ "node": "Job OK?", "type": "main", "index": 0 }],
        [{ "node": "Alert: job failed", "type": "main", "index": 0 }]
      ]
    },
    "Job OK?": {
      "main": [
        [{ "node": "Any sends failed?", "type": "main", "index": 0 }],
        [{ "node": "Alert: job failed", "type": "main", "index": 0 }]
      ]
    },
    "Any sends failed?": {
      "main": [
        [{ "node": "Alert: some reminders failed", "type": "main", "index": 0 }],
        [{ "node": "All sent", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
