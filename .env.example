# Names only. Real values live in Vercel project settings and a local .env.local (git-ignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler URL (port 6543) for the app; drizzle-kit migrate can use the direct URL.
DATABASE_URL=

# Auth
FEATURE_PUBLIC_SIGNUP=false
ALLOWED_EMAILS=

# Jobs (n8n on Firebat) — see docs/jobs-contract.md
JOBS_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# Document review
ANTHROPIC_API_KEY=
MODEL_REVIEW=claude-sonnet-5-5
MODEL_TRIAGE=claude-haiku-4-5-20251001

# Lot screen: environmentally critical area overlays. JSON array of {"name","url"} where url is an
# official City of Seattle GIS ArcGIS MapServer/FeatureServer layer URL (https). Unset = overlays not checked.
SEATTLE_ECA_LAYERS=

# Phase B
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
